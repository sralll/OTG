{
  "name": "city-gen",
  "version": "0.1.0",
  "description": "Voronoi city/ward generator for sprint orienteering maps (port of TownGeneratorOS).",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node test/smoke.mjs",
    "build": "esbuild src/main.js --bundle --format=iife --outfile=dist/app.js",
    "watch": "esbuild src/main.js --bundle --format=iife --outfile=dist/app.js --watch",
    "serve": "python -m http.server 8000"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
